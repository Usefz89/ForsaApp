// Secrets Configuration Template
// Copy this file to Secrets.xcconfig and fill in your values
// Secrets.xcconfig is gitignored and should never be committed

// Alpaca API - Get from https://broker-app.alpaca.markets/
ALPACA_API_KEY = your_alpaca_api_key_here
ALPACA_API_SECRET = your_alpaca_api_secret_here

// Twilio API - Get from https://console.twilio.com/
TWILIO_ACCOUNT_SID = your_twilio_account_sid_here
TWILIO_AUTH_TOKEN = your_twilio_auth_token_here
TWILIO_RECOVERY_CODE = your_twilio_recovery_code_here
TWILIO_VERIFY_SERVICE_SID = your_twilio_verify_service_sid_here
